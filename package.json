{
  "name": "reactjs-electron-boilerplate",
  "productName": "reactjs-electron-boilerplate",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "clean": "rimraf ./.vite ./out ./dist-web",
    "start": "electron-forge start",
    "dev:web": "vite --config vite.config.web.ts --mode development",
    "build:web": "vite build --config vite.config.web.ts --mode production",
    "preview:web": "vite preview --config vite.config.web.ts --mode production",
    "analyze:web": "ANALYZE=true npm run build:web",
    "size:web": "size-limit",
    "lhci": "lhci autorun",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "pretest:e2e": "npm run package",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --config playwright.config.web.ts",
    "postinstall": "npx typesync"
  },
  "keywords": [],
  "author": {
    "name": "Aliaksandr Andreyeu",
    "email": "andreyeu.aliaksandr@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@size-limit/file": "^14.2.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/electron-store": "^3.2.2",
    "@types/eslint": "~9.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "44.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.48.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.2.0",
    "typescript": "~7.0.2",
    "typesync": "^0.14.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@sentry/electron": "^8.2.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "posthog-js": "^1.438.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.15"
  }
}
